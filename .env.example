# Purpose: Environment variable configuration template for ApexFin Banking Portal.
# Architecture/Context: Local and production environment specifications.
# Dependencies/Side Effects: Loaded by app.py via standard environment lookup.

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0
SECRET_KEY=demo-insecure-flask-secret-key-change-in-prod

# Database Configuration
DATABASE_PATH=apexfin.db

# Logging Configuration
LOG_LEVEL=INFO
