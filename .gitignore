# Author: Pradeep Singh
# License: Apache-2.0
# Purpose: Gitignore configuration for the ApexFin Bank CodeMender demo project.
# Architecture/Context: Root-level Git filter for security and build artifact isolation.
# Dependencies/Side Effects: Prevents secrets, environment configurations, and virtual environments from being tracked.

# Python compiled bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/

# Sensitive Environment Configurations & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*service-account*.json
*credentials*.json
.gcloud/

# Local SQLite databases & runtime PID/archives (created dynamically)
*.db
*.db-journal
*.sqlite3
.app.pid
*.tar.gz
*.zip

# Operating System & IDE noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# CodeMender local execution state and logs
.codemender/
.cm_project
state.db*
*.log
logs/
